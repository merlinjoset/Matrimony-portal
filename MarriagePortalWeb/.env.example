# Copy the values you need into .env.local (local dev) or set them as environment
# variables on Render (Dashboard -> your service -> Environment).

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Admin session secret (optional) ---
# Signs the admin login cookie. Defaults to DATABASE_URL if unset; set a dedicated
# value in production so rotating the DB password does not sign everyone out.
# ADMIN_SESSION_SECRET=some-long-random-string

# --- Email / SMTP (optional) ---
# These can also be configured in the admin panel (Admin -> Settings -> Email),
# which is stored in the database and OVERRIDES these env vars. Use either one.
# When set, the app emails the parish office whenever a profile is submitted for
# verification. If unset, email sending is silently skipped (nothing breaks).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465                       # 465 for SSL, 587 for STARTTLS
# SMTP_SECURE=true                    # "true" for port 465
# SMTP_USER=admin@csitamilparishdubai.com
# SMTP_PASS=your-mailbox-password
# SMTP_FROM=admin@csitamilparishdubai.com          # defaults to SMTP_USER
# ADMIN_NOTIFY_EMAIL=admin@csitamilparishdubai.com # who receives new-profile alerts; defaults to SMTP_FROM

# --- App base URL (optional) ---
# Used to build links inside notification emails (e.g. the verification queue).
# APP_BASE_URL=https://matrimony.csitamilparishdubai.com
